<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RegistroEstudiantes.Models"
             x:Class="RegistroEstudiantes.Views.RegistroEstudiantesPage"
             Title="Registro de estudiantes">
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="8">

            <!-- Número de cuenta -->
            <Label Text="Número de cuenta *" />
            <Entry
                x:Name="NumeroCuentaEntry"
                Placeholder="Ej. 20231001"
                Keyboard="Text"
                MaxLength="20"
                ClearButtonVisibility="WhileEditing"
                SemanticProperties.Description="Número de cuenta del estudiante" />

            <!-- Nombre completo -->
            <Label Text="Nombre completo *" />
            <Entry
                x:Name="NombreCompletoEntry"
                Placeholder="Nombre y apellido"
                Keyboard="Text"
                MaxLength="150"
                ClearButtonVisibility="WhileEditing"
                SemanticProperties.Description="Nombre completo del estudiante" />

            <!-- Carrera -->
            <Label Text="Carrera *" />
            <Picker
                x:Name="CarreraPicker"
                Title="Selecciona una carrera"
                SemanticProperties.Description="Carrera del estudiante" />

            <!-- Correo -->
            <Label Text="Correo electrónico *" />
            <Entry
                x:Name="CorreoEntry"
                Placeholder="ejemplo@correo.com"
                Keyboard="Email"
                MaxLength="150"
                ClearButtonVisibility="WhileEditing"
                SemanticProperties.Description="Correo electrónico del estudiante" />

            <!-- Botón Guardar -->
            <Button
                x:Name="GuardarButton"
                Text="Guardar estudiante"
                Margin="0,12,0,0"
                BackgroundColor="{StaticResource Turquesa}"
                TextColor="White"
                FontAttributes="Bold"
                SemanticProperties.Description="Guarda la información del estudiante"
                Clicked="GuardarButton_Clicked" />

            <!-- Lista de estudiantes registrados -->
            <Label
                x:Name="TituloListaLabel"
                Text="Estudiantes registrados"
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,20,0,0"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                x:Name="SinRegistrosLabel"
                Text="Aún no hay estudiantes registrados."
                TextColor="Gray"
                IsVisible="False" />

            <VerticalStackLayout
                x:Name="ListaEstudiantes"
                Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Estudiante">
                        <Border Padding="12" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding NumeroCuenta, StringFormat='Cuenta: {0}'}" />
                                <Label Text="{Binding Carrera}" />
                                <Label Text="{Binding Correo}" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
